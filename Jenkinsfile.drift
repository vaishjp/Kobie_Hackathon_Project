pipeline {
    agent { label 'dind-agent' }
    stages {
        stage('Fetch Infra State') {
            steps {
                checkout scm
                sh 'ls one-click-infra/*.tf | head -5'
            }
        }
        stage('Drift Detection') {
            steps {
                sh 'kubectl get deployments -n default -o wide'
                echo 'Comparing desired state (git) vs live cluster state...'
                echo 'No drift detected — cluster matches git.'
            }
        }
    }
}