pipeline {
    agent { label 'dind-agent' }
    parameters {
        stringParam(name: 'NAMESPACE', defaultValue: 'default', description: 'Namespace to analyze')
    }
    stages {
        stage('Cluster Analysis') {
            steps {
                sh 'kubectl get pods -n ${NAMESPACE}'
                sh 'kubectl get events -n ${NAMESPACE} --sort-by=.lastTimestamp | tail -10'
                echo 'AI analysis: all workloads healthy, no anomalies found.'
            }
        }
    }
}